grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 21
text = "You can move your character through the arena with the left control stick.
With the right control stick, you can change your facing direction, indicated by the white tick mark on your character.
If your facing direction points toward the red zone behind your character, your movement is slowed."

[node name="BallText" type="Label" parent="."]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -472.5
offset_top = -193.5
offset_right = 472.5
offset_bottom = 193.5
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 21
text = "You can throw a ball with the right trigger. It will go straight forward from your facing direction and bounce off walls.
If your ball hits your opponent, they will drop the gem if they have it and they will be warped back to their starting position.
There is a small cooldown, but you can throw your ball again wherever it is, as long as it isn't stolen.

You can steal your opponent's ball if you are facing it and holding the left bumper as it hits you.
If you steal a ball, it will not reset your position.
When a player's ball is stolen, they cannot throw it.
A stolen ball is returned to its owner either by making contact with its owner or when a point is scored.
You cannot move while holding the button to steal, and you drop the gem.
You can throw your opponent's stolen ball with the left trigger. It will act as your own until it is returned to the opponent.

You can parry your opponent's ball if you are facing it and press the right bumper just before it hits you.
The time frame a parry will be successful is indicated by your character flashing white.
If your parry is successful, the ball will be sent directly to your opponent at a higher speed.
While your parry is active, your position and facing direction both freeze."

