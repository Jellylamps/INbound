theme_override_font_sizes/font_size = 21
text = "INbound is a 2 player game intended to be played with standard controllers. 
Each Player's goal is to score more points than their opponent and win the game!

At the center of the arena is a gem. At either side of the arena is a goal zone.
If you pick up the gem (using the left trigger) and carry it to the opponent's goal zone, you score a point!
If you let go of the left trigger while carrying the gem, you drop it. after a short time, it will turn red, then respawn in the center.

A player wins the game if they reach 9 or more points and have at least 2 points more than their opponent.

The start button pauses the game."

[node name="MovementText" type="Label" parent="."]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -450.5
offset_top = -37.5
offset_right = 450.5
